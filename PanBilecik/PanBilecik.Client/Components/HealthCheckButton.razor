@inject HttpClient Http

<button class="btn btn-primary" @onclick="CallHealthAsync">Wywołaj api/health</button>

@if (_result is not null)
{
    <p role="status">@_result</p>
}

@code {
    private string? _result;

    private async Task CallHealthAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<HealthResponse>("api/health");
            _result = $"status: {response?.Status}, czas UTC: {response?.TimeUtc}";
        }
        catch (Exception ex)
        {
            _result = $"Błąd: {ex.Message}";
        }
    }

    private record HealthResponse(string Status, DateTime TimeUtc);
}
